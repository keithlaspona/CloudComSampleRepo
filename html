<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Greeting</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #fce4ec; /* pastel pink */
        }
        .container {
            text-align: center;
            padding: 50px;
            background-color: #f8bbd0; /* light pastel pink */
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .message {
            font-size: 24px;
            color: #d81b60; /* dark pink */
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="message">
            Good Morning!<br>
            Happy Valentine's Day!
        </div>
    </div>

</body>
</html>
